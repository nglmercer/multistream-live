{
  "name": "electron-bootstrap",
  "productName": "electron-bootstrap",
  "description": "The electronjs application launcher",
  "keywords": [],
  "main": "./main.js",
  "version": "2.4.0",
  "author": "melser",
  "scripts": {
    "start": "electron ./src",
    "dev": "node ./src/initserver.js",
    "build": "rimraf build && electron-builder --config electron-builder.yml",
    "build:windows": "rimraf build && electron-builder --win --config electron-builder.yml",
    "build:linux": "rimraf build && electron-builder --linux --config electron-builder.yml",
    "postinstall": "cd src && npm install"
  },
  "devDependencies": {
    "electron": "31.4.0",
    "electron-builder": "24.13.3",
    "rimraf": "6.0.1"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/static": "^8.2.0",
    "fastify": "^5.4.0",
    "@retconned/kick-js": "^0.5.3",
    "axios": "^1.7.9",
    "bonjour-service": "^1.3.0",
    "colors": "^1.4.0",
    "serve-handler": "6.1.5",
    "socket.io": "^4.8.0",
    "strip-ansi": "^7.1.0",
    "tiktok-live-connector": "^1.2.3",
    "uuid": "^11.1.0"
  }
}
